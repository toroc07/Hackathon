{
  "name": "@dispatch/audio-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Servicio independiente de \"llamada\" con IA: orienta por voz al reportero mientras espera la ambulancia. El reporte que crea el incidente (transcripción + dedup real) vive en apps/web, POST /api/incidents/audio.",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dispatch/contracts": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "multer": "^2.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}

# Dependencias
node_modules/
**/node_modules/

# Build
.next/
dist/
out/
*.tsbuildinfo

# Base de datos SQLite — estado local, nunca versionar
packages/db/data/
*.db
*.db-wal
*.db-shm

# Tiles PMTiles — se descargan en setup, pesan demasiado para el repo
*.pmtiles

# Entorno / secretos
.env
.env.*
!.env.example

# Logs / temporales
*.log
.DS_Store

# Vercel CLI — config local del link al proyecto
.vercel/

# Entorno del asistente — no versionar skills de Claude
.claude/

# Python (backend/routing, carpeta pg_api)
__pycache__/
*.pyc
venv/
.venv/
*.egg-info/

# Artefactos de datos generados — se reconstruyen desde los .geojson fuente,
# no se versionan binarios pesados (este pesa 13 MB).
*.pkl

# Build aislado para auditoria visual (NEXT_DIST_DIR) y capturas de pantalla

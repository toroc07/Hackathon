# Copia este archivo a .env.local y rellena los valores.
# .env.local esta en .gitignore: NUNCA subas credenciales al repo.

# ── Base de datos ───────────────────────────────────────────────────────────
# PostgreSQL. Opciones:
#   · Vercel Postgres  -> Storage > Create > Postgres (te da la URL ya formada)
#   · Neon             -> https://neon.tech (tier gratuito)
#   · Local            -> postgresql://postgres:postgres@localhost:5432/dispatch
#
# Los Postgres gestionados requieren TLS; el cliente ya lo maneja.
DATABASE_URL=postgresql://usuario:password@host:5432/basededatos?sslmode=require

# ── Demo ────────────────────────────────────────────────────────────────────
# Con DEMO_MODE=true se habilita el selector de rol sin login y la flota simulada.
DEMO_MODE=true

# ── Transcripción de voz (reporte por audio en la web) ──────────────────────
# Cadena de motores, en orden: Groq Whisper → ElevenLabs Scribe → OpenAI Whisper.
# Con GROQ_API_KEY basta (la más barata, con capa gratuita). Sin ninguna key
# el reporte se crea igual, con el audio guardado y sin transcripción.
# Crea la key en https://console.groq.com/keys
GROQ_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# ── Seguridad de operaciones destructivas ───────────────────────────────────
# `npm run db:reset` BORRA EL ESQUEMA COMPLETO. Contra una base que no sea
# localhost exige ademas ALLOW_REMOTE_RESET=true, para que nadie borre por
# accidente la base compartida del equipo.
# ALLOW_REMOTE_RESET=true

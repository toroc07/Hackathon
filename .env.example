# Copia este archivo a .env.local y rellena los valores.
# .env.local esta en .gitignore: NUNCA subas credenciales al repo.

# ── Base de datos ───────────────────────────────────────────────────────────
# PostgreSQL. Opciones:
#   · Vercel Postgres  -> Storage > Create > Postgres (te da la URL ya formada)
#   · Neon             -> https://neon.tech (tier gratuito)
#   · Local            -> postgresql://postgres:postgres@localhost:5432/dispatch
#
# Los Postgres gestionados requieren TLS; el cliente ya lo maneja.
DATABASE_URL=postgresql://usuario:password@host:5432/basededatos?sslmode=require

# ── Demo ────────────────────────────────────────────────────────────────────
# Con DEMO_MODE=true se habilita el selector de rol sin login y la flota simulada.
DEMO_MODE=true

# ── Transcripción del reporte por voz (POST /api/incidents/audio) ──────────
# Orden: ElevenLabs Scribe -> OpenAI Whisper -> null (el reporte se crea
# igual sin transcripción; nunca se pierde un aviso por un proveedor caído).
# ELEVENLABS_API_KEY=
# OPENAI_API_KEY=

# ── "Llamada" con IA (aparte, ver backend/) ─────────────────────────────────
# Orientación en vivo mientras espera la ambulancia — NO crea incidentes, eso
# es /api/incidents/audio arriba. Corre como servicio independiente en
# backend/; configura backend/.env con su propio GROQ_API_KEY.
# En local: backend/.env con PORT=4001. En producción: la URL pública del
# servicio en Render. NEXT_PUBLIC_ porque AiCallWidget la llama directo desde
# el navegador (cross-origin, el audio-service ya tiene CORS abierto).
AUDIO_SERVICE_URL=http://localhost:4001
NEXT_PUBLIC_AUDIO_SERVICE_URL=http://localhost:4001

# ── Seguridad de operaciones destructivas ───────────────────────────────────
# `npm run db:reset` BORRA EL ESQUEMA COMPLETO. Contra una base que no sea
# localhost exige ademas ALLOW_REMOTE_RESET=true, para que nadie borre por
# accidente la base compartida del equipo.
# ALLOW_REMOTE_RESET=true
